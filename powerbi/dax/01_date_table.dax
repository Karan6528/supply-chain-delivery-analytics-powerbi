// =====================================================================
// Calculated table: Date
// Modeling > New table > paste.  Then: Table tools > Mark as date table (column [Date]).
// Sort "Month" by "Month Number", "Day of Week" by "Day of Week Number".
// =====================================================================
Date =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2025, 12, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Quarter", "Q" & QUARTER ( [Date] ),
    "Month Number", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "MMM" ),
    "Year Month", FORMAT ( [Date], "YYYY-MM" ),
    "Week Start", [Date] - WEEKDAY ( [Date], 3 ),
    "Day of Week", FORMAT ( [Date], "ddd" ),
    "Day of Week Number", WEEKDAY ( [Date], 2 ),
    "Season", IF ( MONTH ( [Date] ) IN { 11, 12 }, "Peak (Nov-Dec)", "Regular (Jan-Oct)" )
)
